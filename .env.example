# Katai Browser Agent Configuration

# Default Model Checkpoint: v10s (recommended, 322M mmBERT-base, ~20ms latency)
# Options: v10s, v10, v11s, typed-decisions, multilingual, english, or a local path
KATAI_CHECKPOINT=v10s

# Chrome DevTools Protocol (CDP) URL
# Defaults to http://127.0.0.1:9222.
# If no Chrome process is listening, Katai automatically launches Google Chrome!
BU_CDP_URL=http://127.0.0.1:9222

# SystemOne Standalone Server Port (TypeSafe Jev API drop-in replacement)
KATAI_SERVER_PORT=8791

# Interactive Web Console Port
KATAI_WEB_PORT=8766

# Maximum steps before stopping
MAX_STEPS=60

# Max candidate options per chunk for coarse-to-fine selection (default: 12)
KATAI_MAX_OPTIONS=12

# Input format version (v3 for fine-tuned checkpoints)
KATAI_FMT=v3

# Optional: System 2 LLM Fallback (escalate when System-1 confidence is below tau, 0.0 = disabled)
ESCALATE_TAU=0.0

# Text model configuration for TYPE_TEXT fields (optional: if omitted, intelligent heuristic extraction is used offline)
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL_API_KEY=
TEXT_MODEL=qwen/qwen-2.5-7b-instruct
